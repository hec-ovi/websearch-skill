# Copy to .env, or just run ./searxng.sh up (it generates one).
# .env is gitignored: the secret is per machine and never committed.

# Required. Any long random string:  head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'
SEARXNG_SECRET=

# Host port. 8888 by default because 8080 is a common collision.
SEARXNG_PORT=8888

# 127.0.0.1 keeps the instance loopback-only. Read "Before exposing it" in README.md
# before changing this.
SEARXNG_HOST=127.0.0.1

# Pin the image instead of tracking latest, e.g. 2026.7.24-4f64d9501
SEARXNG_VERSION=latest

# Egress proxy for SearXNG's OWN engine requests (the hop that reaches Google, Bing,
# and the rest). Defaults to whatever WEBSEARCH_PROXY resolves to, so the searches and
# the rest of the tool leave from the same place. Set to "off" for direct egress.
# SEARXNG_OUTGOING_PROXY=socks5h://user:pass@host:1080
